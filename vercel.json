{
  "rewrites": [
    { "source": "/fn-gs-1", "destination": "/funnel/01-landing.html" },
    { "source": "/fn-gs-2", "destination": "/funnel/02-rechner.html" },
    { "source": "/fn-gs-3", "destination": "/funnel/03-ergebnis.html" },
    { "source": "/impressum", "destination": "/impressum.html" },
    { "source": "/datenschutz", "destination": "/datenschutz.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
